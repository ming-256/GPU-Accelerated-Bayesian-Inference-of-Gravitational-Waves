# Prior file for GW170817 bilby analysis
# Matched to the JAX script priors (GW170817_heterodyned_1.py)
#
# Key settings:
#   - chirp_mass: [1.18, 1.21] (detector frame)
#   - spins: [-0.05, 0.05] (low-spin BNS)
#   - d_L: PowerLaw(alpha=2) on [1, 75] Mpc
#   - Full sky: ra [0, 2pi], dec cosine prior [-pi/2, pi/2]
#   - Component mass constraint: [0.5, 7.7] M_sun

# Masses
chirp_mass = Uniform(minimum=1.18, maximum=1.21, name='chirp_mass', latex_label='$\\mathcal{M}$')
mass_ratio = Uniform(minimum=0.125, maximum=1.0, name='mass_ratio', latex_label='$q$')
mass_1 = Constraint(minimum=0.5, maximum=7.7, name='mass_1')
mass_2 = Constraint(minimum=0.5, maximum=7.7, name='mass_2')

# Spins (aligned, low-spin BNS: magnitude 0 to 0.05)
chi_1 = Uniform(minimum=-0.05, maximum=0.05, name='chi_1', latex_label='$\\chi_1$')
chi_2 = Uniform(minimum=-0.05, maximum=0.05, name='chi_2', latex_label='$\\chi_2$')

# Extrinsic
luminosity_distance = PowerLaw(alpha=2, minimum=1, maximum=75, name='luminosity_distance', latex_label='$d_L$', unit='Mpc')
theta_jn = Sine(minimum=0, maximum=3.141592653589793, name='theta_jn', latex_label='$\\theta_{JN}$')
psi = Uniform(minimum=0, maximum=3.141592653589793, name='psi', latex_label='$\\psi$', boundary='periodic')
phase = Uniform(minimum=0, maximum=6.283185307179586, name='phase', latex_label='$\\phi$', boundary='periodic')

# Sky position: full sky
ra = Uniform(minimum=0, maximum=6.283185307179586, name='ra', latex_label='$\\mathrm{RA}$', boundary='periodic')
dec = Cosine(minimum=-1.5707963267948966, maximum=1.5707963267948966, name='dec', latex_label='$\\mathrm{DEC}$')

# Coalescence time: narrow window around trigger
geocent_time = Uniform(minimum=1187008882.33, maximum=1187008882.53, name='geocent_time', latex_label='$t_c$', unit='s')

# Tidal parameters
lambda_1 = Uniform(minimum=0, maximum=5000, name='lambda_1', latex_label='$\\Lambda_1$')
lambda_2 = Uniform(minimum=0, maximum=5000, name='lambda_2', latex_label='$\\Lambda_2$')
