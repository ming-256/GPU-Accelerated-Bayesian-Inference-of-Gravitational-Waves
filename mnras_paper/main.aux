\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Prior-sensitivity comparison for IMRPhenomXAS\_NRTidalv3\xspace  . \emph  {Left panel (a):} weighted step-histograms of \ensuremath  {H_{0}}\xspace  \ under the four distance-prior variants of Section\nobreakspace  {}\ref {sec:priors} (volumetric baseline, direct uniform-in-$d_L$, reweighted uniform-in-$d_L$, and $\ensuremath  {\sigma _{v_p}}\xspace  =250\ensuremath  {\,\rm  km\,s^{-1}}\xspace  $). The directly sampled uniform-in-$d_L$ posterior places substantially more mass at high \ensuremath  {H_{0}}\xspace  \ than the reweighted estimate, despite both targeting the same prior. \emph  {Right panel (b):} peculiar-velocity centre sweep --- \ensuremath  {H_{0}}\xspace  \ posteriors for $\langle v_{p}\rangle \in \{215,310,405\}\ensuremath  {\,\rm  km\,s^{-1}}\xspace  $ at fixed $\ensuremath  {\sigma _{v_p}}\xspace  =150\ensuremath  {\,\rm  km\,s^{-1}}\xspace  $ (s18 runs). The published Abbott+2017 \ensuremath  {H_{0}}\xspace  $=70_{-8}^{+12}\ensuremath  {\,\rm  km\,s^{-1}\,Mpc^{-1}}\xspace  $ band \citep  {Abbott2017H0} is shown in panel (a) as a vertical reference. Planck $\Lambda $CDM and SH0ES distance-ladder bands are shown in both panels.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:h0prior}{{2}{4}{Prior-sensitivity comparison for \IMRX . \emph {Left panel (a):} weighted step-histograms of \hzero \ under the four distance-prior variants of Section~\ref {sec:priors} (volumetric baseline, direct uniform-in-$d_L$, reweighted uniform-in-$d_L$, and $\sigmavp =250\kms $). The directly sampled uniform-in-$d_L$ posterior places substantially more mass at high \hzero \ than the reweighted estimate, despite both targeting the same prior. \emph {Right panel (b):} peculiar-velocity centre sweep --- \hzero \ posteriors for $\langle v_{p}\rangle \in \{215,310,405\}\kms $ at fixed $\sigmavp =150\kms $ (s18 runs). The published Abbott+2017 \hzero $=70_{-8}^{+12}\kmsmpc $ band \citep {Abbott2017H0} is shown in panel (a) as a vertical reference. Planck $\Lambda $CDM and SH0ES distance-ladder bands are shown in both panels}{figure.2}{}}
