\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The $\ensuremath  {d_{L}}\xspace  $--$\iota $ bimodality in the GW170817 flat-in-redshift posterior. Left: joint $(\ensuremath  {d_{L}}\xspace  ,\iota )$ posterior from the unrestricted $\ensuremath  {d_{L}}\xspace  \in [10,75]\,\rm  Mpc$ run (Mode-B-anchored heterodyne reference); the prior-restricted Mode-A and Mode-B contours from the two separate restricted-prior runs are overlaid in distinct colours, with the $\ensuremath  {d_{L}}\xspace  =30\,\rm  Mpc$ prior boundary marked. Right: per-mode \ensuremath  {H_{0}}\xspace  \ marginals as weighted step-histograms. The Planck $\Lambda $CDM and SH0ES distance-ladder bands are shown for context.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:bimodality}{{3}{6}{The $\dL $--$\iota $ bimodality in the GW170817 flat-in-redshift posterior. Left: joint $(\dL ,\iota )$ posterior from the unrestricted $\dL \in [10,75]\,\rm Mpc$ run (Mode-B-anchored heterodyne reference); the prior-restricted Mode-A and Mode-B contours from the two separate restricted-prior runs are overlaid in distinct colours, with the $\dL =30\,\rm Mpc$ prior boundary marked. Right: per-mode \hzero \ marginals as weighted step-histograms. The Planck $\Lambda $CDM and SH0ES distance-ladder bands are shown for context}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Local evidences, MAP $\ensuremath  {H_{0}}\xspace  $ values, and sample-derived 68 per cent HPDs for the three $\ensuremath  {d_{L}}\xspace  $-restricted flat-in-redshift runs. The Mode-B/Mode-A Bayes factor includes a $\ln (20/45)$ correction for the difference in restricted-prior $\ensuremath  {d_{L}}\xspace  $ volumes.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:bimodality}{{3}{6}{Local evidences, MAP $\hzero $ values, and sample-derived 68 per cent HPDs for the three $\dL $-restricted flat-in-redshift runs. The Mode-B/Mode-A Bayes factor includes a $\ln (20/45)$ correction for the difference in restricted-prior $\dL $ volumes}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces GW170817 \ensuremath  {H_{0}}\xspace  \ posterior for IMRPhenomXAS\_NRTidalv3\xspace  \ (primary, LVK-bounds baseline) and TaylorF2\xspace  \ (family check, LVK-bounds baseline). Vertical markers are 68 per cent and 95 per cent HPD bounds derived from the weighted samples (no KDE smoothing); sample-derived HPDs are reported in Table\nobreakspace  {}\ref {tab:waveform-h0}. The Planck $\Lambda $CDM and SH0ES distance-ladder values are shown for context. The published Abbott+2017 GW170817 \ensuremath  {H_{0}}\xspace  $=70_{-8}^{+12}\ensuremath  {\,\rm  km\,s^{-1}\,Mpc^{-1}}\xspace  $ band \citep  {Abbott2017H0} is shown as a vertical reference.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:waveform-h0}{{4}{6}{GW170817 \hzero \ posterior for \IMRX \ (primary, LVK-bounds baseline) and \TF \ (family check, LVK-bounds baseline). Vertical markers are 68 per cent and 95 per cent HPD bounds derived from the weighted samples (no KDE smoothing); sample-derived HPDs are reported in Table~\ref {tab:waveform-h0}. The Planck $\Lambda $CDM and SH0ES distance-ladder values are shown for context. The published Abbott+2017 GW170817 \hzero $=70_{-8}^{+12}\kmsmpc $ band \citep {Abbott2017H0} is shown as a vertical reference}{figure.4}{}}
