\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Prior-sensitivity comparison for IMRPhenomXAS\_NRTidalv3\xspace  . Weighted step-histograms of \ensuremath  {H_{0}}\xspace  \ under the volumetric baseline and the two flat-in-redshift variants of Section\nobreakspace  {}\ref {sec:priors}. Vertical markers are 68 per cent and 95 per cent HPD bounds derived from the weighted samples (no KDE smoothing). The directly sampled flat-in-redshift posterior places substantially more mass at high \ensuremath  {H_{0}}\xspace  \ than the reweighted estimate, despite both targeting the same prior. The Planck $\Lambda $CDM and SH0ES distance-ladder values are shown for context; the published Abbott+2017 GW170817 \ensuremath  {H_{0}}\xspace  $=70_{-8}^{+12}\ensuremath  {\,\rm  km\,s^{-1}\,Mpc^{-1}}\xspace  $ band \citep  {Abbott2017H0} is shown as a vertical reference. The $\ensuremath  {\sigma _{v_p}}\xspace  =250\ensuremath  {\,\rm  km\,s^{-1}}\xspace  $ peculiar-velocity sweep is reported in Table\nobreakspace  {}\ref {tab:h0priors} and discussed inline rather than promoted to this figure.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:h0prior}{{2}{4}{Prior-sensitivity comparison for \IMRX . Weighted step-histograms of \hzero \ under the volumetric baseline and the two flat-in-redshift variants of Section~\ref {sec:priors}. Vertical markers are 68 per cent and 95 per cent HPD bounds derived from the weighted samples (no KDE smoothing). The directly sampled flat-in-redshift posterior places substantially more mass at high \hzero \ than the reweighted estimate, despite both targeting the same prior. The Planck $\Lambda $CDM and SH0ES distance-ladder values are shown for context; the published Abbott+2017 GW170817 \hzero $=70_{-8}^{+12}\kmsmpc $ band \citep {Abbott2017H0} is shown as a vertical reference. The $\sigmavp =250\kms $ peculiar-velocity sweep is reported in Table~\ref {tab:h0priors} and discussed inline rather than promoted to this figure}{figure.2}{}}
