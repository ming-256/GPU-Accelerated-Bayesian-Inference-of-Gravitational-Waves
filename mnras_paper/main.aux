\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces GW170817 \ensuremath  {H_{0}}\xspace  \ posterior for the three-waveform set of Table\nobreakspace  {}\ref {tab:waveform-h0}: IMRPhenomXAS\_NRTidalv3\xspace  \ (primary, LVK-bounds baseline), IMRPhenomD\_NRTidalv2\xspace  \ (anchor, LVK-bounds baseline), and TaylorF2\xspace  \ (family check, default-mass baseline), plus the GWTC-1 IMRPhenomPv2\_NRTidal posterior mapped through this work's standard-siren likelihood of equation\nobreakspace  {}\ref {eq:h0likelihood}. Vertical markers are 68 per cent and 95 per cent HPD bounds derived from a weighted KDE; sample-derived HPDs are reported in Table\nobreakspace  {}\ref {tab:waveform-h0}. The Planck $\Lambda $CDM and SH0ES distance-ladder values are shown for context. The IMRPhenomPv2 (no tides) cross-check is reported inline in Section\nobreakspace  {}\ref {sec:cross-waveform} and retained in the public test suite.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:waveform-h0}{{2}{4}{GW170817 \hzero \ posterior for the three-waveform set of Table~\ref {tab:waveform-h0}: \IMRX \ (primary, LVK-bounds baseline), \IMR \ (anchor, LVK-bounds baseline), and \TF \ (family check, default-mass baseline), plus the GWTC-1 IMRPhenomPv2\_NRTidal posterior mapped through this work's standard-siren likelihood of equation~\ref {eq:h0likelihood}. Vertical markers are 68 per cent and 95 per cent HPD bounds derived from a weighted KDE; sample-derived HPDs are reported in Table~\ref {tab:waveform-h0}. The Planck $\Lambda $CDM and SH0ES distance-ladder values are shown for context. The IMRPhenomPv2 (no tides) cross-check is reported inline in Section~\ref {sec:cross-waveform} and retained in the public test suite}{figure.2}{}}
