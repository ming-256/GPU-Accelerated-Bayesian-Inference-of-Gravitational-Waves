\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces GW150914 validation: median values of the principal source parameters for our heterodyned IMRPhenomXPHM\xspace  \ run, with a $n_{\rm  live}=5000$ cross-check. The LVK GWTC-2.1 IMRPhenomXPHM\xspace  \ public PE \citep  {Abbott2021GWTC2p1,GWTC2p1_GW150914_Zenodo} reports $\mathcal  {M}_c\approx 30.4\,M_\odot $, $q\approx 0.85$, $d_L\approx 463\,\rm  Mpc$, $\iota \approx 2.62\,\rm  rad$ for direct comparison.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:gw150914}{{1}{4}{GW150914 validation: median values of the principal source parameters for our heterodyned \XPHM \ run, with a $n_{\rm live}=5000$ cross-check. The LVK GWTC-2.1 \XPHM \ public PE \citep {Abbott2021GWTC2p1,GWTC2p1_GW150914_Zenodo} reports $\mathcal {M}_c\approx 30.4\,M_\odot $, $q\approx 0.85$, $d_L\approx 463\,\rm Mpc$, $\iota \approx 2.62\,\rm rad$ for direct comparison}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces GW150914 validation: corner overlay of the LVK GWTC-2.1 IMRPhenomXPHM\xspace  \ posterior \citep  {Abbott2021GWTC2p1,GWTC2p1_GW150914_Zenodo} and our heterodyned IMRPhenomXPHM\xspace  \ run at $n_{\rm  live}=8000$, $n_{\rm  mcmc}=160$. The two posteriors overlap throughout the recovered support; our component-mass prior $[5,100]\,M_\odot $ encompasses the LVK $[10,80]\,M_\odot $ range without adding posterior mass at the boundaries.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:gw150914}{{1}{4}{GW150914 validation: corner overlay of the LVK GWTC-2.1 \XPHM \ posterior \citep {Abbott2021GWTC2p1,GWTC2p1_GW150914_Zenodo} and our heterodyned \XPHM \ run at $n_{\rm live}=8000$, $n_{\rm mcmc}=160$. The two posteriors overlap throughout the recovered support; our component-mass prior $[5,100]\,M_\odot $ encompasses the LVK $[10,80]\,M_\odot $ range without adding posterior mass at the boundaries}{figure.1}{}}
