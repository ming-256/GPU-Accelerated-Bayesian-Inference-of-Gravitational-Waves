\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces GW170817 wall-clock scaling. Heterodyned and unheterodyned wall-clock as a function of $n_{\rm  live}$ for the IMRPhenomD\_NRTidalv2\xspace  \ family on default-mass and LVK-bounds prior sets, with the TaylorF2\xspace  \ unheterodyned point at $n_{\rm  live}=1500$ for context. The heterodyned LVK-bounds series has log--log gradient $\simeq 0.60$ over the plotted range; matched unheterodyned points are $31\times $/$51\times $/$68\times $ slower at $n_{\rm  live}=500/1500/2500$.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:scaling}{{6}{9}{GW170817 wall-clock scaling. Heterodyned and unheterodyned wall-clock as a function of $n_{\rm live}$ for the \IMR \ family on default-mass and LVK-bounds prior sets, with the \TF \ unheterodyned point at $n_{\rm live}=1500$ for context. The heterodyned LVK-bounds series has log--log gradient $\simeq 0.60$ over the plotted range; matched unheterodyned points are $31\times $/$51\times $/$68\times $ slower at $n_{\rm live}=500/1500/2500$}{figure.6}{}}
