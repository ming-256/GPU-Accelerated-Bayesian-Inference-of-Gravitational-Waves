\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Prior-sensitivity comparison for IMRPhenomXAS\_NRTidalv3\xspace  . Weighted step-histograms of \ensuremath  {H_{0}}\xspace  \ under the volumetric baseline and the two flat-in-redshift variants of Section\nobreakspace  {}\ref {sec:priors}, with the GWTC-1 IMRPhenomPv2\_NRTidal posterior mapped through this work's standard-siren likelihood overlaid as the literature reference. The directly sampled flat-in-redshift posterior places substantially more mass at high \ensuremath  {H_{0}}\xspace  \ than the reweighted estimate. The $\ensuremath  {\sigma _{v_p}}\xspace  =250\ensuremath  {\,\rm  km\,s^{-1}}\xspace  $ peculiar-velocity sweep is reported in Table\nobreakspace  {}\ref {tab:h0priors} and discussed inline rather than promoted to this figure.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:h0prior}{{4}{6}{Prior-sensitivity comparison for \IMRX . Weighted step-histograms of \hzero \ under the volumetric baseline and the two flat-in-redshift variants of Section~\ref {sec:priors}, with the GWTC-1 IMRPhenomPv2\_NRTidal posterior mapped through this work's standard-siren likelihood overlaid as the literature reference. The directly sampled flat-in-redshift posterior places substantially more mass at high \hzero \ than the reweighted estimate. The $\sigmavp =250\kms $ peculiar-velocity sweep is reported in Table~\ref {tab:h0priors} and discussed inline rather than promoted to this figure}{figure.4}{}}
