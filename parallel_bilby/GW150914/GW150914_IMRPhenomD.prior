# Prior file for GW150914 parallel_bilby — IMRPhenomD
# Matched to JAX analysis priors (GW150914_heterodyned.py)
#
# IMRPhenomD is aligned-spin only, so we use chi_1/chi_2 (z-components)
# rather than precessing spin parameters (a_1, tilt_1, etc.).

# Masses — detector-frame chirp mass [10, 80], mass ratio [0.125, 1]
chirp_mass = Uniform(minimum=10.0, maximum=80.0, name='chirp_mass', latex_label='$\\mathcal{M}$')
mass_ratio = Uniform(minimum=0.125, maximum=1.0, name='mass_ratio', latex_label='$q$')
mass_1 = Constraint(minimum=1.0, maximum=100.0, name='mass_1')
mass_2 = Constraint(minimum=1.0, maximum=100.0, name='mass_2')

# Aligned spins [-1, 1] (IMRPhenomD: aligned spin only)
chi_1 = Uniform(minimum=-1.0, maximum=1.0, name='chi_1', latex_label='$\\chi_1$')
chi_2 = Uniform(minimum=-1.0, maximum=1.0, name='chi_2', latex_label='$\\chi_2$')

# Extrinsic parameters
luminosity_distance = PowerLaw(alpha=2, minimum=1.0, maximum=2000.0, name='luminosity_distance', latex_label='$d_L$', unit='Mpc')
theta_jn = Sine(minimum=0, maximum=3.141592653589793, name='theta_jn', latex_label='$\\theta_{JN}$')
psi = Uniform(minimum=0, maximum=3.141592653589793, name='psi', latex_label='$\\psi$', boundary='periodic')
phase = Uniform(minimum=0, maximum=6.283185307179586, name='phase', latex_label='$\\phi$', boundary='periodic')

# Sky position — full sky
ra = Uniform(minimum=0, maximum=6.283185307179586, name='ra', latex_label='$\\mathrm{RA}$', boundary='periodic')
dec = Cosine(minimum=-1.5707963267948966, maximum=1.5707963267948966, name='dec', latex_label='$\\mathrm{DEC}$')

# Coalescence time — narrow window around trigger (±0.05s, matching JAX)
geocent_time = Uniform(minimum=1126259462.35, maximum=1126259462.45, name='geocent_time', latex_label='$t_c$', unit='s')
